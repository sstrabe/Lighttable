// Cloudflare Workers config: the site is static assets only, served from the `npm run build`
// output. Missing paths get out/404.html with a 404 status.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lighttable",
    "compatibility_date": "2026-09-29",
    "assets": {
        "directory": "./out",
        "not_found_handling": "404-page"
    }
}
