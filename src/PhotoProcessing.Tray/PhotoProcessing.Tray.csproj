<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>photoedit-tray</AssemblyName>
    <RootNamespace>PhotoProcessing.Tray</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The exe's icon; the notification-area icon is drawn at runtime to show status (TrayIcons). -->
    <ApplicationIcon>..\..\assets\logo\lighttable.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoProcessing.Core\PhotoProcessing.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same versions as the CLI: both publish into one bin folder and share its appsettings.json. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
  </ItemGroup>

</Project>
