{
  "PhotoProcessing": {
    // Runtime data (darktable config, Claude editor workspace, jobs, logs). Empty = %USERPROFILE%\.photoprocessing
    // "Home": "",
    // Empty = PATH, then %LOCALAPPDATA%\Programs\darktable and Program Files.
    "DarktableCli": "",
    "PreviewSize": 1500,
    "Claude": {
      "Executable": "claude",
      // Empty = the claude CLI's default model for your plan. E.g. "opus" or "sonnet".
      "Model": "",
      "Effort": "",
      "MaxTurns": 60,
      "Timeout": "00:20:00"
    },
    "Heimdall": {
      // Nextcloud access comes from signing in with Heimdall: run `photoedit login` once. The sign-in
      // (and so whose files the watcher sees) is kept in <Home>\state\heimdall.json.
      "Issuer": "https://sso.heimdall.sstrabe.dev/realms/heimdall",
      // From the app's OAuth2 page on Heimdall. A confidential app also has a secret, which goes in
      // user secrets, not here:
      //   dotnet user-secrets --project src/PhotoProcessing.Cli set PhotoProcessing:Heimdall:ClientSecret <secret>
      "ClientId": "2cdd9470-5c4b-4823-9ecc-ffc37217754b",
      // Register exactly this redirect URI on the app's page. `photoedit login` listens on it.
      "RedirectUri": "http://127.0.0.1:38517/callback",
      "Scope": "openid profile nextcloud.files.write offline_access"
    },
    "Nextcloud": {
      "BaseUrl": "https://cloud.sstrabe.dev",
      // Paths in the files of the person signed in to Heimdall (sstrabe). Signed in as someone the
      // folder is shared with, they'd be under "Shared/" instead: this server mounts incoming shares there.
      // The inbox is never created by the watcher; the other folders are created next to it.
      "InboxFolder": "Photos/Processing/Inbox",
      "OutputFolder": "Photos/Processing/Processed",
      "ArchiveFolder": "Photos/Processing/Archive",
      "FailedFolder": "Photos/Processing/Failed",
      "PollInterval": "00:01:00",
      "SettleTime": "00:00:30",
      "MaxAttempts": 2
    }
  }
}
