<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>photoedit</AssemblyName>
    <RootNamespace>PhotoProcessing.Cli</RootNamespace>
    <UserSecretsId>photoprocessing-photoedit</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoProcessing.Core\PhotoProcessing.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Claude editor workspace template, synced to <Home>/editor before every edit. -->
    <None Include="..\..\editor\CLAUDE.md" Link="editor\CLAUDE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\editor\.claude\settings.json" Link="editor\.claude\settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
